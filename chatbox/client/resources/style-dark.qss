* {
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 13px;
    color: #F2F4F7;
}

QMainWindow, QDialog {
    background: #1A2027;
}

QWidget#LoginPage {
    background: #1A2027;
}

QFrame#LoginCard {
    background: #0F1419;
    border: 1px solid #323B44;
    border-radius: 16px;
}

QLabel#AppLogo {
    background: #4D8DFF;
    color: #FFFFFF;
    border-radius: 28px;
    font-size: 28px;
    font-weight: 600;
}

QLabel#AppTitle {
    font-size: 26px;
    font-weight: 600;
    color: #F2F4F7;
}

QLabel#AppSubtitle {
    color: #8A929C;
    font-size: 12px;
}

QLabel#SectionLabel {
    color: #8A929C;
    font-size: 11px;
    font-weight: 600;
    padding: 8px 6px 4px 6px;
}

QLabel#ContextTitle {
    font-size: 16px;
    font-weight: 600;
    padding: 2px 4px;
}

QLabel#MutedLabel {
    color: #8A929C;
    font-size: 12px;
}

QLineEdit, QSpinBox {
    background: #232B33;
    border: 1px solid #323B44;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: #4D8DFF;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QSpinBox:focus {
    background: #0F1419;
    border: 1px solid #4D8DFF;
}

QTextEdit#MessageInput {
    background: #232B33;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 8px 12px;
}

QTextEdit#MessageInput:focus {
    background: #0F1419;
    border: 1px solid #4D8DFF;
}

QPushButton {
    background: #232B33;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
}

QPushButton[keyboardFocus="true"]:focus {
    border: 2px solid #4D8DFF;
    padding: 6px 10px;
}

QPushButton:hover {
    background: #2B343D;
}

QPushButton:pressed {
    background: #323B44;
}

QPushButton:disabled {
    color: #79818B;
    background: #1A2027;
}

QPushButton#PrimaryButton {
    background: #2F6FDC;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background: #2660C7;
}

QPushButton#PrimaryButton[keyboardFocus="true"]:focus {
    border: 2px solid #4D8DFF;
    padding: 6px 10px;
}

QPushButton#PrimaryButton:pressed {
    background: #1F54B0;
}

QPushButton#PrimaryButton:disabled {
    background: #2B343D;
    color: #8A929C;
}

QPushButton#SendButton {
    background: #2F6FDC;
    color: #FFFFFF;
    border-radius: 18px;
    padding: 8px 14px;
}

QPushButton#SendButton:hover {
    background: #2660C7;
}

QPushButton#SendButton[keyboardFocus="true"]:focus {
    border: 2px solid #4D8DFF;
    padding: 6px 12px;
}

QPushButton#SendButton:pressed {
    background: #1F54B0;
}

QPushButton#IconButton {
    padding: 7px;
}

QPushButton#SidebarAction, QPushButton#FooterAction {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0 8px;
    color: #F2F4F7;
    font-size: 13px;
    text-align: left;
}

QPushButton#SidebarAction:hover, QPushButton#FooterAction:hover {
    background: #1A2027;
}

QPushButton#DangerFooterAction {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0 8px;
    color: #FF8A80;
    font-size: 13px;
}

QPushButton#DangerFooterAction:hover {
    background: #1A2027;
}

QLabel#FriendRequestBadge {
    background: #2F6FDC;
    color: #FFFFFF;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
}

QWidget#Sidebar {
    background: #0F1419;
    border-right: 1px solid #323B44;
}

QWidget#RightSidebar {
    background: #0F1419;
    border-left: 1px solid #323B44;
}

QWidget#ChatPanel {
    background: #1A2027;
}

QWidget#ChatHeader {
    background: #0F1419;
    border-bottom: 1px solid #323B44;
}

QWidget#Composer {
    background: #0F1419;
    border-top: 1px solid #323B44;
}

QTextBrowser {
    background: #1A2027;
    border: none;
    padding: 8px;
}

QFrame#MessageActionBar {
    background: #0F1419;
    border: 1px solid #323B44;
    border-radius: 12px;
}

QFrame#MessageActionBar QPushButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 3px 9px;
    color: #4D8DFF;
    font-size: 11px;
}

QFrame#MessageActionBar QPushButton:hover {
    background: #1A2027;
}

QFrame#MessageActionBar QPushButton[keyboardFocus="true"]:focus {
    border: 1px solid #4D8DFF;
}

QFrame#MessageActionBar QPushButton:pressed {
    background: #232B33;
}

QStackedWidget {
    background: #1A2027;
}

QStatusBar {
    background: #0F1419;
    border-top: 1px solid #323B44;
    color: #8A929C;
}

QStatusBar QLabel {
    color: #8A929C;
    padding-left: 6px;
}

QListWidget {
    background: transparent;
    border: none;
    padding: 0;
}

QListWidget[keyboardFocus="true"]:focus {
    border: 2px solid #4D8DFF;
    border-radius: 10px;
}

QListWidget::item {
    padding: 9px 10px;
    border-radius: 8px;
    margin: 1px 0;
}

QListWidget::item:hover {
    background: #1A2027;
    border: 1px solid transparent;
}

/* 见 style.qss 同名注释：选中态要和悬停态拉开，不能只和未选中拉开。 */
QListWidget::item:selected {
    background: #2A3E5C;
    border: 1px solid #3D6299;
    color: #F2F4F7;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #79818B;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #8A929C;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    border: none;
    height: 0;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #79818B;
    background: #0F1419;
}

QCheckBox::indicator:checked {
    background: #4D8DFF;
    border: 1px solid #4D8DFF;
    image: url(:/icons/check.png);
}

QCheckBox[keyboardFocus="true"]::indicator:focus {
    border: 2px solid #4D8DFF;
}

/* 见 style.qss：三种控件原先无规则，深色下会露出系统浅色外观。 */
QComboBox {
    background: #232B33;
    border: 1px solid #323B44;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 20px;
}

QComboBox:hover {
    background: #2B343D;
}

QComboBox:focus {
    background: #0F1419;
    border: 1px solid #4D8DFF;
}

QComboBox:disabled {
    background: #1A2027;
    color: #9AA2AC;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron-dark.png);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background: #0F1419;
    border: 1px solid #323B44;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #2A3E5C;
    selection-color: #F2F4F7;
}

QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 1px solid #9AA2AC;
    background: #0F1419;
}

QRadioButton::indicator:checked {
    border: 1px solid #4D8DFF;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
                                stop:0 #4D8DFF, stop:0.45 #4D8DFF,
                                stop:0.55 #0F1419, stop:1 #0F1419);
}

QRadioButton::indicator:disabled {
    border-color: #323B44;
}

QRadioButton[keyboardFocus="true"]::indicator:focus {
    border: 2px solid #4D8DFF;
}

QGroupBox {
    border: 1px solid #323B44;
    border-radius: 12px;
    margin-top: 10px;
    padding: 14px 12px 10px 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: #8A929C;
    font-size: 11px;
    font-weight: 600;
}

QDialogButtonBox QPushButton {
    min-width: 72px;
}

QMenu {
    background: #0F1419;
    border: 1px solid #323B44;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #232B33;
    color: #F2F4F7;
}

QToolTip {
    background: #F2F4F7;
    color: #FFFFFF;
    border: none;
    padding: 6px 8px;
}
QToolButton#MoreButton, QToolButton#AdvancedOptionsButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0px;
}

QToolButton[keyboardFocus="true"]:focus {
    background: #2B343D;
    border: 2px solid #4D8DFF;
    border-radius: 8px;
}

QToolButton#MoreButton[keyboardFocus="true"]:focus,
QToolButton#AdvancedOptionsButton[keyboardFocus="true"]:focus {
    background: #2B343D;
    border: 2px solid #4D8DFF;
    border-radius: 8px;
}

QToolButton#MoreButton:hover, QToolButton#AdvancedOptionsButton:hover {
    background: #2B343D;
}

QToolButton#MoreButton:pressed, QToolButton#AdvancedOptionsButton:pressed {
    background: #2B343D;
}

QToolButton#MoreButton::menu-indicator {
    image: none;
    width: 0px;
}

/* Dark-specific tooltip: light-on-dark surfaces would be unreadable. */
QToolTip {
    background: #232B33;
    color: #FFFFFF;
}


QLabel#EmptyStateTitle {
    font-size: 15px;
    font-weight: 600;
    color: #F2F4F7;
}

QLabel#EmptyStateDescription {
    font-size: 13px;
    color: #8A929C;
}

QPushButton#EmptyStateAction {
    background: transparent;
    border: none;
    color: #4D8DFF;
    font-size: 13px;
    padding: 6px 8px;
}

QPushButton#EmptyStateAction:hover {
    color: #3B7BEB;
}

QLabel#ProfileNameLabel {
    font-size: 22px;
    font-weight: 600;
    color: #F2F4F7;
}

QLabel#SettingsIdLabel {
    font-weight: 600;
    color: #F2F4F7;
}

QLabel#SettingsCaption {
    color: #8A929C;
}

QLabel#HistoryPathLabel {
    color: #AEB6C0;
}

QLabel#SettingsVersion {
    color: #8A929C;
}

QPushButton#MyProfileButton {
    background: #0F1419;
    border: none;
    border-top: 1px solid #323B44;
    border-radius: 0;
    padding: 4px 2px;
}

QPushButton#MyProfileButton:hover {
    background: #1A2027;
}

QPushButton#MyProfileButton:pressed {
    background: #232B33;
}

QLabel#MyProfileName {
    font-size: 13px;
    font-weight: 600;
    color: #F2F4F7;
}

QLabel#MyProfileUid {
    font-size: 11px;
    color: #8A929C;
}

QLabel#MessageByteCounter {
    font-size: 11px;
}
