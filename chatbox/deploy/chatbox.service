[Unit]
Description=ChatBox TCP Framework
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xxw
WorkingDirectory=/home/xxw/桌面/0917/chatbox
ExecStart=/home/xxw/桌面/0917/chatbox/tools/run_server.sh --listen 127.0.0.1 --port 9100 --io-threads 4 --worker-threads 4 --max-connections 20000 --max-conn-per-ip 0 --proxy-protocol
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
Environment=TZ=UTC

[Install]
WantedBy=multi-user.target
